# ==============================================================================
# HangerHome Backend Environment Configuration
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Database Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/hanger_commerce
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hanger_commerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hanger_commerce

# Authentication Secrets (minimum 32 characters, keep secret in production!)
JWT_SECRET=super_secret_hangerhome_jwt_key_please_change_in_production_min32
JWT_REFRESH_SECRET=super_secret_hangerhome_refresh_jwt_key_please_change_in_production_min32

# Client Frontend URL (Used for CORS validation, email confirmation links, and sitemap generation)
CLIENT_URL=http://localhost:5173

# Initial Admin User Credentials (Used by npm run seed to create the first admin account if not present)
ADMIN_EMAIL=admin@hangerhome.com
ADMIN_PASSWORD=Admin@HangerHome2026
ADMIN_NAME=Store Administrator
ADMIN_PHONE=+91 98765 43210

# Razorpay Online Payment Gateway (Optional - if left empty, COD is automatically used)
# Client only ever receives RAZORPAY_KEY_ID; RAZORPAY_KEY_SECRET is strictly backend-only.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Nodemailer / SMTP Configuration (Optional - for order confirmations, booking alerts, and password resets)
# If omitted or left empty, emails are logged to server console gracefully without throwing errors.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@hangerhome.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="HangerHome Luxury" <notifications@hangerhome.com>

# Cloudinary Cloud Storage (Optional - fallback is local uploads served at /uploads with 7-day cache)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI Integration (Optional - powers the AI shopping stylist / catalog assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
