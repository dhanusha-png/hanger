# ==============================================================================
# HangerHome Client (Vite React) Environment Configuration
# Copy this file to .env or .env.local and configure values.
# ==============================================================================

# Backend Express API base URL (with /api suffix)
VITE_API_URL=http://localhost:5000/api

# Backend server origin (without /api suffix) for resolving local uploads and media
VITE_API_ORIGIN=http://localhost:5000

# Razorpay Key ID (public key used in browser checkout script)
# Optional - leave blank to only use Cash on Delivery (COD)
VITE_RAZORPAY_KEY_ID=
